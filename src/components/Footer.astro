---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] py-8 mt-16">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-[var(--text-secondary)] text-sm">
        <span>&copy; {currentYear}</span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:block">Agi Maulana</span>
      </div>
      
      <div class="flex items-center gap-6">
        <a href="https://github.com/AgiMaulana" target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors text-sm">
          GitHub
        </a>
        <a href="https://linkedin.com/in/AgiMaulana" target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors text-sm">
          LinkedIn
        </a>
        <a href="https://twitter.com/AgiMaulanaXyz" target="_blank" rel="noopener" class="text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors text-sm">
          Twitter
        </a>
        <a href="mailto:agimaulana.dex@gmail.com" class="text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors text-sm">
          Email
        </a>
      </div>
    </div>
  </div>
</footer>