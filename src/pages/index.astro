---
import BaseLayout from '../layouts/BaseLayout.astro';

const impactMetrics = [
  { value: "99.8%", label: "Crash-free shortly after the Android rewrite shipped" },
  { value: "40–60%", label: "Faster release cycles via CI/CD and trunk-based development" },
  { value: "5 engineers", label: "Mobile engineering organization led, Android and iOS" },
  { value: "7 months", label: "From rewrite kickoff to full production cutover" },
];

const capabilities = [
  {
    title: "Android Engineering",
    description: "Designing and modernizing Android applications with Kotlin, Jetpack Compose, modular architecture, testing, and scalable engineering practices.",
  },
  {
    title: "Architecture & System Design",
    description: "Modular Clean Architecture with explicit ownership boundaries, predictable data flow, and testability that keeps teams shipping independently.",
  },
  {
    title: "Technical Leadership",
    description: "Turning ambiguous technical problems into architecture, execution plans, standards, and sustainable delivery.",
  },
  {
    title: "Engineering Productivity",
    description: "CI/CD, developer tooling, automation, release processes, and internal tooling that make engineers faster.",
  },
];

const howILead = [
  {
    title: "Lead through systems, not micromanagement",
    body: "I create processes, visibility, expectations, and feedback loops so engineers can operate independently. Show & Tell is the example: a lightweight ritual that creates real awareness without turning leadership into status-checking.",
  },
  {
    title: "Give engineers ownership",
    body: "Engineers propose solutions before they receive guidance. Delegating technical ownership builds decisions inside the team instead of handing them down.",
  },
  {
    title: "Make quality part of the system",
    body: "TDD, Compose UI testing, architecture conventions, CI/CD pipelines, technical-debt ownership, and release processes designed so quality doesn't depend on heroics.",
  },
  {
    title: "Build culture deliberately",
    body: "Psychological safety, recognition, and mentoring: environments where junior engineers ask questions freely and senior engineers keep growing.",
  },
];

const progression = [
  {
    stage: "Android Engineer",
    body: "Built products end to end and developed deep Android expertise, from health-tech apps to streaming platforms at large scale.",
  },
  {
    stage: "Senior Android Engineer",
    body: "Owned architecture, complex features, quality, and technical direction, leading a 100% Kotlin + Compose greenfield rewrite.",
  },
  {
    stage: "Android Lead",
    body: "Led Android engineers and contractors through modular Clean Architecture, establishing testing, release, and review practices.",
  },
  {
    stage: "Mobile Engineering Leader",
    body: "Expanded scope across Android and iOS: people leadership, delivery, engineering culture, and organizational systems.",
  },
];

const projects = [
  {
    name: "GooglePlayConsoleMcp",
    url: "https://github.com/AgiMaulana/GooglePlayConsoleMcp",
    problem: "Publishing to Google Play is slow, click-heavy, and easy to get wrong.",
    built: "MCP server covering the publishing workflow: artifacts, release tracks, staged rollouts, testing, and Play Console operations.",
  },
  {
    name: "HuaweiAppGalleryMcp",
    url: "https://github.com/AgiMaulana/HuaweiAppGalleryMcp",
    problem: "AppGallery operations have no good automation story.",
    built: "MCP server for app metadata, AAB uploads, phased and scheduled releases, testing, and reporting.",
  },
  {
    name: "CodemagicMcp",
    url: "https://github.com/agimaulana/codemagicmcp",
    problem: "CI/CD state lives in a dashboard engineers have to keep checking.",
    built: "MCP server exposing Codemagic builds, artifacts, logs, environment variables, and caches to AI agents.",
  },
  {
    name: "SentryCompanionMcp",
    url: "https://github.com/AgiMaulana/SentryCompanionMcp",
    problem: "The official Sentry MCP doesn't cover everything engineers need.",
    built: "Companion MCP server with extra Sentry tooling for triage workflows.",
  },
  {
    name: "SlackBotMcp",
    url: "https://github.com/AgiMaulana/SlackBotMcp",
    problem: "AI agents can't naturally act where teams actually communicate.",
    built: "MCP server that reads channels and threads and sends bot messages inside AI workflows.",
  },
];
---

<BaseLayout title="Agi Maulana - Senior Android Engineer & Mobile Engineering Leader">
  <!-- Hero -->
  <section class="pt-24 pb-14">
    <div class="container-prose">
      <p class="flex items-center gap-2 text-sm text-[var(--text-muted)] mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
        Open to Senior Android / Lead Android / Mobile Engineering Leadership opportunities
      </p>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3">
        Agi Maulana
      </h1>

      <p class="text-lg md:text-xl text-[var(--text-secondary)] mb-4">
        Senior Android Engineer &amp; Mobile Engineering Leader
      </p>

      <p class="text-base text-[var(--text-secondary)] max-w-2xl mb-3">
        I build reliable Android products, lead engineering teams, and improve the systems and practices that help engineers ship better software.
      </p>

      <p class="text-sm text-[var(--text-muted)] mb-8">
        Android · Kotlin · Jetpack Compose · Architecture · Technical Leadership · Engineering Productivity
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="#impact" class="btn-primary">View my work</a>
        <a href="https://www.linkedin.com/in/agimaulana/" target="_blank" rel="noopener" class="btn-secondary">LinkedIn</a>
        <a href="https://github.com/AgiMaulana" target="_blank" rel="noopener" class="btn-secondary">GitHub</a>
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section id="impact" class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">Impact</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
        {impactMetrics.map((m) => (
          <div>
            <p class="metric text-[var(--text)]">{m.value}</p>
            <p class="text-sm text-[var(--text-muted)] mt-1">{m.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="pb-16">
    <div class="container-prose">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-6">About</h2>
      <p class="text-[var(--text-secondary)] mb-4">
        I'm an Android engineer who grew into mobile engineering leadership, without leaving the technical roots behind.
      </p>
      <p class="text-[var(--text-secondary)] mb-4">
        I started with products: owning an Android app end to end, modernizing legacy Java, shipping features used at large scale. Good architecture and testing became the lens through which I judged everything I built.
      </p>
      <p class="text-[var(--text-secondary)] mb-4">
        At Good Doctor Technology I led the ground-up rewrite of a flagship health-tech Android app, in Kotlin, Jetpack Compose, modular Clean Architecture, and Hilt. It shipped in 7 months and reached 99.8% crash-free shortly after release. Then I built the organization around it: an Android team turned into a mobile engineering organization spanning Android and iOS, with shared practices, release processes, and AI-driven internal tooling.
      </p>
      <p class="text-[var(--text-secondary)]">
        Today my focus is engineering systems: architecture conventions, CI/CD, developer productivity, and AI infrastructure. The things that let teams move fast without sacrificing quality.
      </p>
    </div>
  </section>

  <!-- What I do -->
  <section id="engineering" class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">What I do</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
        {capabilities.map((c) => (
          <div>
            <h3 class="font-semibold mb-1">{c.title}</h3>
            <p class="text-[var(--text-secondary)] text-sm">{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Lead -->
  <section id="leadership" class="pb-16">
    <div class="container-prose">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">How I lead</h2>
      <div class="divide-y divide-[var(--border)]">
        {howILead.map((l) => (
          <div class="entry">
            <h3 class="font-semibold mb-1">{l.title}</h3>
            <p class="text-[var(--text-secondary)] text-sm">{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Progression -->
  <section id="progression" class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">Engineer, then senior, then lead, then mobile leader</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-x-10 gap-y-8">
        {progression.map((p) => (
          <div>
            <p class="text-sm font-semibold text-[var(--accent)] mb-1">{p.stage}</p>
            <p class="text-sm text-[var(--text-secondary)]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Good Doctor case study -->
  <section id="experience" class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">Good Doctor Technology</h2>
      <p class="text-[var(--text-muted)] text-sm mb-8">Senior Android Engineer → Android Lead → Lead Mobile Engineer · July 2023 – Present · Jakarta</p>

      <div class="space-y-10">
        <div>
          <h3 class="font-semibold mb-2">The rewrite</h3>
          <p class="text-[var(--text-secondary)] text-base max-w-3xl">
            I joined when the Android product depended heavily on an external development vendor. I led the complete ground-up rewrite in Kotlin and Jetpack Compose: modular Clean Architecture, MVVM, Hilt, TDD, full unit test coverage, with a cross-functional team of 7 engineers across in-house, contractors, and vendors.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-5">
            <div>
              <p class="metric text-base">7 months</p>
              <p class="text-xs text-[var(--text-muted)]">rewrite kickoff to cutover</p>
            </div>
            <div>
              <p class="metric text-base">99.8%</p>
              <p class="text-xs text-[var(--text-muted)]">crash-free after release</p>
            </div>
            <div>
              <p class="metric text-base">100%</p>
              <p class="text-xs text-[var(--text-muted)]">unit test coverage at delivery</p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="font-semibold mb-2">The system around it</h3>
          <p class="text-[var(--text-secondary)] text-base max-w-3xl">
            Then I built the engineering system around the product, not just the application: architecture conventions, testing practices, a release-train process with staged rollouts (10% → 100%, immediate halt on regressions), technical-debt ownership, engineering rituals, mentoring, and collaboration across the mobile organization.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-5">
            <div>
              <p class="metric text-base">40–60%</p>
              <p class="text-xs text-[var(--text-muted)]">reduction in CI/CD queue times</p>
            </div>
            <div>
              <p class="metric text-base">10% → 100%</p>
              <p class="text-xs text-[var(--text-muted)]">staged rollout with halt-on-regression</p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="font-semibold mb-2">The organization</h3>
          <p class="text-[var(--text-secondary)] text-base max-w-3xl">
            Beyond the Android app, I led the mobile organization: 5 engineers across Android and iOS. Shared retrospectives, Show &amp; Tell, and joint learning across platforms. I drove the Huawei AppGallery integration, bringing the app to 1.5M potential new users, and created Skola, an internal marketplace for reusable AI Skills and MCP servers.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-5">
            <div>
              <p class="metric text-base">5 engineers</p>
              <p class="text-xs text-[var(--text-muted)]">mobile organization, Android + iOS</p>
            </div>
            <div>
              <p class="metric text-base">1.5M users</p>
              <p class="text-xs text-[var(--text-muted)]">reach via AppGallery integration</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Earlier experience -->
  <section class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-6">Earlier</h2>
      <div class="divide-y divide-[var(--border)]">
        <div class="entry">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h3 class="font-semibold">Vidio · Android Engineer (Technical Expert)</h3>
            <span class="text-sm text-[var(--text-muted)] whitespace-nowrap">Oct 2022 – Jul 2023</span>
          </div>
          <p class="text-[var(--text-secondary)] text-sm max-w-3xl">Owned core components of Indonesia's #1 OTT streaming Android app at tens of millions of monthly active users. Designed and built a shared ExoPlayer-based core player library used by both mobile and Android TV apps. Stabilized and refactored the Android TV app using the Leanback UI toolkit. Daily TDD, pair programming, and extreme programming practices.</p>
        </div>

        <div class="entry">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <h3 class="font-semibold">Justika · Junior Software Engineer → Android Chapter Lead</h3>
            <span class="text-sm text-[var(--text-muted)] whitespace-nowrap">Aug 2019 – Oct 2022</span>
          </div>
          <p class="text-[var(--text-secondary)] text-sm max-w-3xl">Took full ownership of the Lawyer Connect Android app within months of joining. Migrated legacy Java to Kotlin + MVVM + RxJava. Shipped VoIP calling (Twilio) and in-app chat (SendBird). Later founded and led the Android Chapter: hired and onboarded engineers, led greenfield development of Client Connect, and rewrote the flagship app with Flutter + Riverpod. Built the mobile code review process the mobile org still uses.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section id="projects" class="pb-16">
    <div class="container-custom">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-4">Things I build outside the day job</h2>
      <p class="text-[var(--text-secondary)] text-base max-w-2xl mb-8">
        I build tools because I encounter engineering problems and want to solve them, not because a job description says so.
      </p>
      <div class="divide-y divide-[var(--border)]">
        {projects.map((p) => (
          <div class="entry">
            <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-x-8 gap-y-1">
              <a href={p.url} target="_blank" rel="noopener" class="hover-link font-mono text-sm font-medium self-baseline">
                {p.name}
              </a>
              <p class="text-[var(--text-secondary)] text-sm">{p.problem} {p.built}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-8">
        <a href="https://github.com/AgiMaulana?tab=repositories" target="_blank" rel="noopener" class="hover-link text-sm">All GitHub repositories</a>
      </p>
    </div>
  </section>

  <!-- Principles -->
  <section id="principles" class="pb-16">
    <div class="container-prose">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-8">Engineering principles</h2>
      <ul class="space-y-3 text-[var(--text-secondary)]">
        <li>Good architecture should make the next engineer faster.</li>
        <li>Leadership should increase team autonomy, not dependency on the leader.</li>
        <li>Processes should create visibility, not bureaucracy.</li>
        <li>Technical debt needs ownership, not just documentation.</li>
        <li>The best engineering standards are the ones the team can actually sustain.</li>
      </ul>
    </div>
  </section>

  <!-- Interested in -->
  <section id="currently" class="pb-16">
    <div class="container-prose">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-6">What I'm interested in</h2>
      <p class="text-[var(--text-secondary)] mb-4">
        I'm interested in engineering roles where I can stay close to technology while expanding my impact through technical leadership and team leadership.
      </p>
      <p class="text-[var(--text-secondary)] mb-4">Roles where that fits:</p>
      <ul class="list-disc list-inside text-[var(--text-secondary)] mb-6 space-y-1">
        <li>Senior Android Engineer</li>
        <li>Lead Android Engineer</li>
        <li>Staff / Principal Android Engineer</li>
        <li>Mobile Engineering Manager</li>
      </ul>
      <p class="text-[var(--text-muted)] text-sm">
        Currently: building MCP servers for Google Play, Huawei AppGallery, Codemagic, and Sentry, turning developer infrastructure into things AI agents can operate directly.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="pb-24">
    <div class="container-prose">
      <hr class="rule mb-10" />
      <h2 class="text-2xl font-semibold mb-4">Contact</h2>
      <p class="text-[var(--text-secondary)] mb-6">
        Interested in building great engineering teams and products together?
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="mailto:agimaulana.dex@gmail.com" class="btn-primary">Email me</a>
        <a href="https://www.linkedin.com/in/agimaulana/" target="_blank" rel="noopener" class="btn-secondary">LinkedIn</a>
        <a href="https://github.com/AgiMaulana" target="_blank" rel="noopener" class="btn-secondary">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
