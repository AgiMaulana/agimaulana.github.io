---
import BaseLayout from '../layouts/BaseLayout.astro';

const impactMetrics = [
  { value: "99.8%", label: "Crash-free after Android rewrite" },
  { value: "40–60%", label: "Faster release cycles via CI/CD & trunk-based development" },
  { value: "5 engineers", label: "Mobile engineering organization led (Android + iOS)" },
  { value: "7 months", label: "Full ground-up Android rewrite" },
];

const capabilities = [
  {
    title: "Android Engineering",
    description: "Designing and modernizing Android applications with Kotlin, Jetpack Compose, modular architecture, testing, and scalable engineering practices.",
  },
  {
    title: "Architecture & System Design",
    description: "Modular Clean Architecture with explicit ownership boundaries, predictable data flow, and testability that keeps teams shipping independently.",
  },
  {
    title: "Technical Leadership",
    description: "Turning ambiguous technical problems into architecture, execution plans, standards, and sustainable delivery.",
  },
  {
    title: "Engineering Productivity",
    description: "CI/CD, developer tooling, automation, release processes, and internal tooling that make engineers faster.",
  },
];

const howILead = [
  {
    title: "Lead through systems, not micromanagement",
    body: "I create processes, visibility, expectations, and feedback loops so engineers can operate independently. Lightweight rituals — like Show & Tell — create awareness without turning leadership into status-checking.",
  },
  {
    title: "Give engineers ownership",
    body: "Technical ownership is delegated deliberately. Engineers propose solutions before receiving guidance, so decisions are built inside the team, not handed down.",
  },
  {
    title: "Make quality part of the system",
    body: "TDD, Compose UI testing, architecture conventions, CI/CD pipelines, technical-debt ownership, and release processes designed so quality doesn't depend on heroics.",
  },
  {
    title: "Build culture deliberately",
    body: "Psychological safety, recognition, and mentoring: environments where junior engineers ask questions freely and senior engineers keep growing.",
  },
];

const progression = [
  {
    stage: "Android Engineer",
    body: "Built products end to end and developed deep Android expertise — from health-tech apps to streaming platforms at millions-user scale.",
  },
  {
    stage: "Senior Android Engineer",
    body: "Owned architecture, complex features, quality, and technical direction — leading a 100% Kotlin + Compose greenfield rewrite.",
  },
  {
    stage: "Android Lead",
    body: "Led Android engineers and contractors through modular Clean Architecture, establishing testing, release, and review practices.",
  },
  {
    stage: "Mobile Engineering Leader",
    body: "Expanded scope across Android + iOS: people leadership, delivery, engineering culture, and organizational systems.",
  },
];

const projects = [
  {
    name: "GooglePlayConsoleMcp",
    problem: "Publishing to Google Play is slow, click-heavy, and easy to get wrong.",
    built: "MCP server covering the publishing workflow: artifacts, release tracks, staged rollouts, testing, and Play Console operations.",
    url: "https://github.com/AgiMaulana/GooglePlayConsoleMcp",
  },
  {
    name: "HuaweiAppGalleryMcp",
    problem: "AppGallery operations have no good automation story.",
    built: "MCP server for app metadata, AAB uploads, phased and scheduled releases, testing, and reporting.",
    url: "https://github.com/AgiMaulana/HuaweiAppGalleryMcp",
  },
  {
    name: "CodemagicMcp",
    problem: "CI/CD state lives in a dashboard engineers have to keep checking.",
    built: "MCP server exposing Codemagic builds, artifacts, logs, environment variables, and caches to AI agents.",
    url: "https://github.com/agimaulana/codemagicmcp",
  },
  {
    name: "SentryCompanionMcp",
    problem: "The official Sentry MCP doesn't cover everything engineers need.",
    built: "Companion MCP server with extra Sentry tooling for triage workflows.",
    url: "https://github.com/AgiMaulana/SentryCompanionMcp",
  },
  {
    name: "SlackBotMcp",
    problem: "AI agents can't naturally act where teams actually communicate.",
    built: "MCP server that reads channels and threads and sends bot messages inside AI workflows.",
    url: "https://github.com/AgiMaulana/SlackBotMcp",
  },
];

const roles = [
  "Senior Android Engineer",
  "Lead Android Engineer",
  "Staff / Principal Android Engineer",
  "Mobile Engineering Manager",
];
---

<BaseLayout title="Agi Maulana - Senior Android Engineer & Mobile Engineering Leader">
  <!-- Hero -->
  <section class="pt-32 pb-16">
    <div class="container-custom max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-secondary)] border border-[var(--border)] text-sm text-[var(--text-secondary)] mb-6 opacity-0 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        <span>Open to Senior Android / Lead Android / Mobile Engineering Leadership opportunities</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold mb-4 opacity-0 animate-slide-up stagger-1">
        Agi Maulana
      </h1>

      <p class="text-xl md:text-2xl font-semibold text-[var(--accent)] mb-4 opacity-0 animate-slide-up stagger-2">
        Senior Android Engineer &amp; Mobile Engineering Leader
      </p>

      <p class="text-lg text-[var(--text-secondary)] mb-6 opacity-0 animate-slide-up stagger-3">
        I build reliable Android products, lead engineering teams, and improve the systems and practices that help engineers ship better software.
      </p>

      <p class="text-base text-[var(--text-muted)] mb-8 opacity-0 animate-slide-up stagger-3">
        Android &nbsp;·&nbsp; Kotlin &nbsp;·&nbsp; Jetpack Compose &nbsp;·&nbsp; Architecture &nbsp;·&nbsp; Technical Leadership &nbsp;·&nbsp; Engineering Productivity
      </p>

      <div class="flex flex-wrap gap-4 mb-8 opacity-0 animate-slide-up stagger-4">
        <a href="#impact" class="btn-primary">View my work</a>
        <a href="https://www.linkedin.com/in/agimaulana/" target="_blank" rel="noopener" class="btn-secondary">LinkedIn</a>
        <a href="https://github.com/AgiMaulana" target="_blank" rel="noopener" class="btn-secondary">GitHub</a>
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section id="impact" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up stagger-1">Impact</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 opacity-0 animate-slide-up stagger-2">
        {impactMetrics.map((m) => (
          <div>
            <p class="text-3xl md:text-4xl font-bold text-[var(--accent)] mb-1">{m.value}</p>
            <p class="text-sm text-[var(--text-muted)]">{m.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About / story -->
  <section id="about" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-3xl">
      <h2 class="text-3xl font-bold mb-6 opacity-0 animate-slide-up">About</h2>
      <p class="text-lg text-[var(--text-secondary)] mb-4 opacity-0 animate-slide-up stagger-1">
        I'm an Android engineer who grew into mobile engineering leadership — without leaving the technical roots behind.
      </p>
      <p class="text-[var(--text-secondary)] mb-4 opacity-0 animate-slide-up stagger-2">
        I started with products: owning an Android app end to end, modernizing legacy Java, shipping features used at large scale. Good architecture and testing became the lens through which I judged everything I built.
      </p>
      <p class="text-[var(--text-secondary)] mb-4 opacity-0 animate-slide-up stagger-3">
        At Good Doctor Technology I led the ground-up rewrite of a flagship health-tech Android app — Kotlin, Jetpack Compose, modular Clean Architecture, Hilt — in 7 months, reaching 99.8% crash-free shortly after release. Then I built the organization around it: an Android team turned into a mobile engineering organization spanning Android and iOS, with shared practices, release processes, and AI-driven internal tooling.
      </p>
      <p class="text-[var(--text-secondary)] opacity-0 animate-slide-up stagger-4">
        Today my focus is engineering systems: architecture conventions, CI/CD, developer productivity, and AI infrastructure — the things that let teams move fast without sacrificing quality.
      </p>
    </div>
  </section>

  <!-- What I do -->
  <section id="engineering" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">What I do</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 opacity-0 animate-slide-up stagger-1">
        {capabilities.map((c) => (
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">{c.title}</h3>
            <p class="text-[var(--text-secondary)] text-sm">{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Lead -->
  <section id="leadership" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">How I Lead</h2>
      <div class="space-y-6 opacity-0 animate-slide-up stagger-1">
        {howILead.map((l) => (
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">{l.title}</h3>
            <p class="text-[var(--text-secondary)] text-sm">{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Progression -->
  <section id="progression" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">Engineer → Senior → Lead → Mobile Leader</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 opacity-0 animate-slide-up stagger-1">
        {progression.map((p) => (
          <div class="card">
            <p class="text-sm font-medium text-[var(--accent)] mb-2 font-mono">{p.stage}</p>
            <p class="text-sm text-[var(--text-secondary)]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Selected Experience: Good Doctor -->
  <section id="experience" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">Selected Experience</h2>

      <div class="card mb-8 opacity-0 animate-slide-up stagger-1">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-6">
          <div>
            <h3 class="text-xl font-semibold">Good Doctor Technology</h3>
            <p class="text-[var(--text-secondary)]">Senior Android Engineer → Android Lead → Lead Mobile Engineer</p>
          </div>
          <span class="text-sm text-[var(--text-muted)] whitespace-nowrap">July 2023 – Present · Jakarta</span>
        </div>

        <h4 class="font-semibold mb-2">The rewrite</h4>
        <p class="text-[var(--text-secondary)] mb-6 text-sm">
          I joined when the Android product depended heavily on an external development vendor. I led the complete ground-up rewrite in Kotlin and Jetpack Compose — modular Clean Architecture, MVVM, Hilt, TDD, 100% unit test coverage — with a cross-functional team of 7 engineers across in-house, contractors, and vendors. The rewrite went live in 7 months, reached a 99.8% crash-free rate shortly after release, and let the company sunset expensive legacy contracts.
        </p>

        <h4 class="font-semibold mb-2">The system around it</h4>
        <p class="text-[var(--text-secondary)] mb-4 text-sm">
          Then I built the engineering system around the product — not just the application. Architecture conventions, testing practices, release-train process with staged rollouts (10% → 100%, immediate halt on regressions), technical-debt ownership, engineering rituals, mentoring, and collaboration across the mobile organization. Mobile CI/CD queue times dropped 40–60% through trunk-based development and build pipeline optimization.
        </p>
        <h4 class="font-semibold mb-2">The organization</h4>
        <p class="text-[var(--text-secondary)] mb-4 text-sm">
          Beyond the Android app, I led the mobile organization — 5 engineers across Android and iOS. Established shared retrospectives, Show &amp; Tell, and joint learning across platforms. On the product owned side, I drove the Huawei AppGallery integration (HMS Push Kit) bringing the app to 1.5M potential new users. I also created Skola, an internal marketplace for reusable AI Skills and MCP servers — see it at <a href="https://good-doctor-technology.github.io/skola-marketplace/" target="_blank" rel="noopener" class="text-[var(--accent)] hover:underline">good-doctor-technology.github.io/skola-marketplace</a>.
        </p>

        <div class="flex flex-wrap gap-2 mt-4">
          {["Kotlin", "Jetpack Compose", "Clean Architecture", "Hilt", "TDD", "CI/CD", "Codemagic", "GitHub Actions", "Swift", "HMS Push Kit"].map((t) => (
            <span class="px-2 py-1 rounded bg-[var(--bg-tertiary)] text-xs">{t}</span>
          ))}
        </div>
      </div>

      <div class="opacity-0 animate-slide-up stagger-2">
        <h3 class="text-xl font-semibold mb-6 mt-12">Earlier</h3>
        <div class="space-y-6">
          <div class="card">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-2">
              <div>
                <h4 class="text-lg font-semibold">Vidio</h4>
                <p class="text-[var(--text-secondary)]">Android Engineer (Technical Expert)</p>
              </div>
              <span class="text-sm text-[var(--text-muted)] whitespace-nowrap">Oct 2022 – Jul 2023</span>
            </div>
            <p class="text-[var(--text-secondary)] text-sm">Owned core components of Indonesia's #1 OTT streaming Android app at tens of millions of monthly active users. Designed and built a shared ExoPlayer-based core player library used by both mobile and Android TV apps. Stabilized and refactored the Android TV app using the Leanback UI toolkit. Daily TDD, pair programming, and extreme programming practices.</p>
          </div>

          <div class="card">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-2">
              <div>
                <h4 class="text-lg font-semibold">Justika</h4>
                <p class="text-[var(--text-secondary)]">Junior Software Engineer → Android Chapter Lead</p>
              </div>
              <span class="text-sm text-[var(--text-muted)] whitespace-nowrap">Aug 2019 – Oct 2022</span>
            </div>
            <p class="text-[var(--text-secondary)] text-sm">Took full ownership of the Lawyer Connect Android app within months of joining. Migrated legacy Java to Kotlin + MVVM + RxJava. Shipped VoIP calling (Twilio) and in-app chat (SendBird). Later founded and led the Android Chapter — hired and onboarded engineers, led greenfield development of Client Connect, and rewrote the flagship app with Flutter + Riverpod. Built the mobile code review process and best-practices that the mobile org still uses today.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source & Experiments -->
  <section id="projects" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl font-bold mb-4 opacity-0 animate-slide-up">Things I Build Outside the Day Job</h2>
      <p class="text-lg text-[var(--text-secondary)] mb-10 opacity-0 animate-slide-up stagger-1">
        I build tools because I encounter engineering problems and want to solve them — not because a job description says so.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 opacity-0 animate-slide-up stagger-2">
        {projects.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="card group flex flex-col h-full">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-semibold group-hover:text-[var(--accent)] transition-colors">{p.name}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--text-muted)] group-hover:text-[var(--accent)] transform group-hover:translate-x-1 transition-all">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            <p class="text-[var(--text-muted)] text-sm mb-2">{p.problem}</p>
            <p class="text-[var(--text-secondary)] text-sm">{p.built}</p>
          </a>
        ))}
      </div>
      <a href="https://github.com/AgiMaulana?tab=repositories" target="_blank" rel="noopener" class="opacity-0 animate-slide-up stagger-3 inline-flex items-center gap-2 mt-8 text-[var(--accent)] hover:underline">
        All GitHub projects
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:translate-x-1 transition-transform">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <!-- Engineering Principles -->
  <section id="principles" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-3xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">Engineering Principles</h2>
      <ul class="space-y-4 opacity-0 animate-slide-up stagger-1">
        <li class="flex items-start gap-3">
          <span class="text-[var(--accent)] mt-1">→</span>
          <p class="text-[var(--text-secondary)]">Good architecture should make the next engineer faster.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--accent)] mt-1">→</span>
          <p class="text-[var(--text-secondary)]">Leadership should increase team autonomy, not dependency on the leader.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--accent)] mt-1">→</span>
          <p class="text-[var(--text-secondary)]">Processes should create visibility, not bureaucracy.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--accent)] mt-1">→</span>
          <p class="text-[var(--text-secondary)]">Technical debt needs ownership, not just documentation.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--accent)] mt-1">→</span>
          <p class="text-[var(--text-secondary)]">The best engineering standards are the ones the team can actually sustain.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Currently / roles targeting -->
  <section id="currently" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-3xl">
      <h2 class="text-3xl font-bold mb-10 opacity-0 animate-slide-up">What I'm interested in</h2>
      <p class="text-lg text-[var(--text-secondary)] mb-6 opacity-0 animate-slide-up stagger-1">
        I'm interested in engineering roles where I can stay close to technology while expanding my impact through technical leadership and team leadership.
      </p>
      <div class="flex flex-wrap gap-2 opacity-0 animate-slide-up stagger-2 mb-8">
        {roles.map((r) => (
          <span class="px-3 py-1.5 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)] text-sm">{r}</span>
        ))}
      </div>
      <p class="text-[var(--text-muted)] opacity-0 animate-slide-up stagger-3">
        Currently: building MCP servers for Google Play, Huawei AppGallery, Codemagic, and Sentry — turning developer infrastructure into things AI agents can operate directly.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-16 border-t border-[var(--border)]">
    <div class="container-custom max-w-3xl">
      <h2 class="text-3xl font-bold mb-4 opacity-0 animate-slide-up">Contact</h2>
      <p class="text-lg text-[var(--text-secondary)] mb-8 opacity-0 animate-slide-up stagger-1">
        Interested in building great engineering teams and products together?
      </p>
      <div class="flex flex-wrap gap-4 opacity-0 animate-slide-up stagger-2">
        <a href="mailto:agimaulana.dex@gmail.com" class="btn-primary">Email</a>
        <a href="https://www.linkedin.com/in/agimaulana/" target="_blank" rel="noopener" class="btn-secondary">LinkedIn</a>
        <a href="https://github.com/AgiMaulana" target="_blank" rel="noopener" class="btn-secondary">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
