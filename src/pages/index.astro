---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Agi Maulana - Lead Mobile Engineer">
  <section class="min-h-screen flex items-center justify-center pt-16">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-secondary)] border border-[var(--border)] text-sm text-[var(--text-secondary)] mb-6 opacity-0 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          <span>Open to opportunities</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold mb-6 opacity-0 animate-slide-up stagger-1">
          Hi, I'm <span class="text-[var(--accent)]">Agi Maulana</span>
        </h1>

        <p class="text-xl md:text-2xl text-[var(--text-secondary)] mb-8 opacity-0 animate-slide-up stagger-2">
          Lead Mobile Engineer <span class="text-[var(--text)]">(Android + iOS)</span>
        </p>

        <p class="text-lg text-[var(--text-muted)] mb-12 max-w-2xl mx-auto opacity-0 animate-slide-up stagger-3">
          Building world-class mobile apps at scale. Expert in Kotlin, Jetpack Compose, Clean Architecture, and leading high-performing engineering teams.
        </p>

        <div class="flex flex-wrap justify-center gap-4 opacity-0 animate-slide-up stagger-4">
          <a href="/about" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
            About Me
          </a>
          <a href="https://www.linkedin.com/in/agimaulana/" target="_blank" rel="noopener" class="btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>

      <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-6 opacity-0 animate-slide-up stagger-5">
        <div class="card group">
          <div class="w-12 h-12 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <path d="M12 18h.01"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Android Excellence</h3>
          <p class="text-[var(--text-secondary)]">Kotlin, Jetpack Compose, Clean Architecture. Led full app rewrites to 99.8% crash-free.</p>
        </div>

        <div class="card group">
          <div class="w-12 h-12 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Technical Leadership</h3>
          <p class="text-[var(--text-secondary)]">Leading mobile org (5 eng), CI/CD, mentoring, and building engineering culture.</p>
        </div>

        <div class="card group">
          <div class="w-12 h-12 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center mb-4 group-hover:bg-[var(--accent)]/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">iOS & Cross-Platform</h3>
          <p class="text-[var(--text-secondary)]">Leading both Android & iOS teams. Trunk-based dev, Swift, and cross-platform delivery.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>