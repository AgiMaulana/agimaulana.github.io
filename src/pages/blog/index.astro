---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../../islands/BlogList';
---

<BaseLayout title="Blog - Agi Maulana" description="Writing on Android development, mobile architecture, and engineering practices.">
  <section class="pt-24 pb-24">
    <div class="container-prose">
      <h1 class="text-4xl font-bold tracking-tight mb-4">Blog</h1>
      <p class="text-lg text-[var(--text-secondary)] mb-4">
        Thoughts on mobile development, engineering practices, and lessons learned building apps at scale.
      </p>
      <p class="text-sm text-[var(--text-muted)] mb-10">
        Writing on <a href="https://medium.com/@agimaulana" target="_blank" rel="noopener" class="hover-link">Medium</a>
      </p>

      <hr class="rule mb-10" />

      <BlogList client:load />

      <div class="mt-12">
        <a href="https://medium.com/@agimaulana" target="_blank" rel="noopener" class="hover-link text-sm">View all posts on Medium</a>
      </div>
    </div>
  </section>
</BaseLayout>
